#!/usr/bin/env bash
# Full local gate before anything leaves this machine: forbidden patterns + swift build + swift test.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] bash scripts/check.sh" >&2
if ! bash scripts/check.sh; then
  echo "✘ pre-push: scripts/check.sh failed. Fix it before pushing; do not bypass with --no-verify." >&2
  exit 1
fi
